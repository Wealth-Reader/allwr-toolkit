# ALL WR Toolkit environment variables.
# Copy to .env and fill in real values. NEVER commit .env.
# All values below are placeholders and do not work anywhere.

# ALL WR target API key (create one under Settings -> API keys in your ALL WR
# workspace; it needs the tasks:import scope for migrations).
ALLWR_TOOLKIT_ALLWR_API_KEY=wrk_example_not_a_real_key

# Asana personal access token (only needed for live Asana API mode).
ALLWR_TOOLKIT_ASANA_TOKEN=1/1200000000000001:example_not_a_real_token

# Freshdesk API key (only needed for the Freshdesk connector).
ALLWR_TOOLKIT_FRESHDESK_API_KEY=example_not_a_real_key

# MCP server: mutating tools stay disabled unless this is exactly "true".
ALLWR_MCP_ALLOW_WRITES=false
